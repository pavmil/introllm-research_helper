# Скопируй в .env и заполни. Файл .env не коммитится и не читается агентами.

# Semantic Scholar API — НЕОБЯЗАТЕЛЬНО. Без ключа запросы идут через общий пул и часто
# получают 429; ключ даёт собственный лимит. Запрашивается через форму на сайте S2.
S2_API_KEY=

# OpenAlex polite pool: адрес для заголовка mailto
OPENALEX_EMAIL=

# LLM-провайдеры (через litellm; заполни те, что используешь)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Запасной веб-поиск для baseline STORM, пока нет ключа S2
TAVILY_API_KEY=

# Мягкий лимит расходов на один запуск эксперимента, USD.
# Жёсткий лимит дополнительно выставь в кабинете провайдера.
LLM_COST_LIMIT_USD=20
